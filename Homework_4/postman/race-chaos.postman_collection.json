        },
        "description": "Invalid request: same race as the valid case but truncated to 3 results (below the min_length=10 bound) and the first driver's position set to 99 (above the le=30 bound). Verified against serve.app with FastAPI's TestClient to actually return 422 with a Pydantic validation error list. Expect 422 and a non-empty detail array."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status code is 422', function () {",
