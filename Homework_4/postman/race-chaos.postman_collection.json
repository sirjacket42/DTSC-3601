 70,\n      \"status\": \"finished\",\n      \"time_millis\": 6400621\n    },\n    {\n      \"grid\": 20,\n      \"position\": 15,\n      \"laps\": 69,\n      \"status\": \"lapped\",\n      \"time_millis\": 6401455\n    },\n    {\n      \"grid\": 12,\n      \"position\": 16,\n      \"laps\": 52,\n      \"status\": \"retired\",\n      \"time_millis\": null\n    },\n    {\n      \"grid\": 10,\n      \"position\": 17,\n      \"laps\": 52,\n      \"status\": \"retired\",\n      \"time_millis\": null\n    },\n    {\n      \"grid\": 16,\n      \"position\": 18,\n      \"laps\": 51,\n      \"status\": \"retired\",\n      \"time_millis\": null\n    },\n    {\n      \"grid\": 11,\n      \"position\": 19,\n      \"laps\": 40,\n      \"status\": \"retired\",\n      \"time_millis\": null\n    },\n    {\n      \"grid\": 13,\n      \"position\": 20,\n      \"laps\": 23,\n      \"status\": \"retired\",\n      \"time_millis\": null\n    }\n  ],\n  \"track_status\": {\n    \"safety_cars\": 2,\n    \"virtual_safety_cars\": 0,\n    \"red_flags\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/chaos-score",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "chaos-score"
          ]
        },
        "description": "Valid request: the real example race from the fitted bundle (bundle['example_request'], a 20-driver field with 2 safety cars and 5 retirements). Expect 200 and a full ChaosScoreResponse."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('chaos_score and weirdness_score are numbers in [0, 100]', function () {",
              "    pm.expect(json.chaos_score).to.be.a('number');",
              "    pm.expect(json.chaos_score).to.be.at.least(0).and.at.most(100);",
              "    pm.expect(json.weirdness_score).to.be.a('number');",
              "    pm.expect(json.weirdness_score).to.be.at.least(0).and.at.most(100);",
              "});",
              "",
              "pm.test('chaos_label is one of the four expected labels', function () {",
              "    pm.expect(['Calm', 'Eventful', 'Chaotic', 'Legendary']).to.include(json.chaos_label);",
              "});",
              "",
              "pm.test('features object has exactly 6 keys', function () {",
              "    pm.expect(json.features).to.be.an('object');",
              "    pm.expect(Object.keys(json.features).length).to.eql(6);",
              "});",
              "",
              "pm.test('most_similar_races has exactly 3 entries', function () {",
              "    pm.expect(json.most_similar_races).to.be.an('array');",
              "    pm.expect(json.most_similar_races.length).to.eql(3);",
              "});"
            ]
          }
        }
      ]
    },
